# gitattributes:begin | управляется sync-gitattributes.py, правьте dev-utils/gitattributes/
# Индекс всегда LF: это контракт репозитория, одинаковый на любой машине и в
# любой среде. Он не зависит от того, что поставил инсталлятор git и что стоит
# в core.autocrlf на конкретном компьютере.
#
# Рабочее дерево — рендеринг, и ниже он задан только там, где перевод строк
# важен исполняющей программе, а не привычке. Всё остальное пусть рисуется как
# принято на платформе: заставлять редактор видеть LF там, где это ни на что не
# влияет, — вкусовщина, а не инженерия.
*                    text=auto

# Исполняются на Linux: CRLF после shebang даёт `bad interpreter: /bin/bash^M`.
*.sh                 text eol=lf
*.bash               text eol=lf

# Часть из них запускается напрямую по shebang — например agent_launchers.py,
# который в дев-контейнере лежит симлинком в ~/.local/bin.
*.py                 text eol=lf

# cmd.exe разбирает многострочные конструкции и метки goto по CRLF.
*.bat                text eol=crlf
*.cmd                text eol=crlf
# gitattributes:end

* text=auto eol=lf

# Generated source files
src/*.json linguist-generated
src/parser.c linguist-generated
src/tree_sitter/* linguist-generated

# Rust bindings
bindings/rust/* linguist-generated
Cargo.toml linguist-generated
Cargo.lock linguist-generated

# Node.js bindings
bindings/node/* linguist-generated
binding.gyp linguist-generated
package.json linguist-generated
package-lock.json linguist-generated

# Python bindings
bindings/python/** linguist-generated
setup.py linguist-generated
pyproject.toml linguist-generated
